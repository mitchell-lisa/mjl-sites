# preview (default) or production
NEXT_PUBLIC_SITE_MODE=preview

# Canonical URL used in metadata, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://mjl-bella-ciao-pizza.vercel.app

# Booking email. Both must be set or the form asks the guest to call.
RESEND_API_KEY=
BOOKING_TO_EMAIL=
# Verified sender, for example: Bella Ciao Pizza <bookings@yourdomain.com>
BOOKING_FROM_EMAIL=
